PORT=5050
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anwar_clinic
JWT_SECRET=anwar-clinic-dev-secret-change-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3100

# Absolute base URL of this API — uploaded file URLs are built from it.
PUBLIC_URL=http://localhost:5050

# File storage: "local" (disk, default) or "s3".
STORAGE_DRIVER=local
MAX_UPLOAD_BYTES=10485760

# --- S3: fill these in and set STORAGE_DRIVER=s3. No code changes needed. ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional folder inside the bucket, e.g. clinic/media
S3_KEY_PREFIX=
# Optional CloudFront / custom domain serving the bucket
S3_PUBLIC_BASE_URL=
